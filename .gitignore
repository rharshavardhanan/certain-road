# Data, models, run outputs — large, regenerable, never committed
# Anchored to the repo root: an unanchored `data/` also matches
# configs/data/, which holds committed dataset YAMLs (T2).
/data/
/models/
/runs/

# Python
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/
.import_linter_cache/
*.egg-info/

# macOS
.DS_Store

# Pretrained checkpoints downloaded by ultralytics
*.pt

# T1 visual-QA renders: 21MB of JPEGs, regenerated deterministically by
# scripts/qa_raw.py (SEED = 0). The findings live in results/T1/raw_audit.md.
results/**/qa/

# T3 staging area: hard-links into data/yolo, rebuilt by scripts/stage_upload.py
/data/kaggle_upload/

# Kaggle staging: hard-links / copies, rebuilt by scripts
/data/kaggle_weights/
/kaggle/build/

# Submission archives: git archive output, rebuilt on demand (README-DA2.md)
/dist/

# ROS 2 demo workspace (D093): colcon output, rebuilt by `colcon build` in ros/
/ros/build/
/ros/install/
/ros/log/

# Review backups: copies of recordings and reports (ros/record_backup.sh collect)
/review_backup/
